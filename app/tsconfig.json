{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": {
      "@traceflow/core": ["../packages/core/src/index.ts"],
      "@traceflow/ui": ["../packages/ui/src/index.ts"],
      "@traceflow/ui/styles.css": ["../packages/ui/src/styles/app.css"]
    }
  },
  "include": ["src/backend", "src/frontend/src", "test"]
}
